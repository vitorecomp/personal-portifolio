{
  "name": "personal-portifolio",
  "version": "2.0.0",
  "private": true,
  "description": "Project portfolio and GitHub documentation hub for Vitor (vitorx86.dev)",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "build:export": "NEXT_EXPORT=true next build --webpack",
    "start": "next start",
    "sync": "node scripts/sync-github-projects.mjs",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:dev": "docker compose --profile dev up --build dev",
    "docker:down": "docker compose --profile dev down",
    "podman:build": "podman-compose -f podman-compose.yml build",
    "podman:up": "podman-compose -f podman-compose.yml up -d",
    "podman:dev": "podman-compose -f podman-compose.yml --profile dev up --build dev",
    "podman:down": "podman-compose -f podman-compose.yml --profile dev down"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitorecomp/personal-portifolio.git"
  },
  "author": "Vieira Vitor <https://vitorx86.dev>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vitorecomp/personal-portifolio/issues"
  },
  "homepage": "https://vitorx86.dev",
  "dependencies": {
    "next": "16.3.6",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "zod": "4.1.12"
  },
  "pnpm": {
    "overrides": {
      "zod": "4.1.12"
    }
  }
}
